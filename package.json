{
  "name": "dsh-plugin-doubao-search",
  "version": "0.1.2",
  "description": "豆包搜索（火山引擎 联网搜索/Web Search API）DSH 插件：全局 doubao_search 模型工具 + Web「设置-插件」配置卡片，API Key 经设置命名空间/环境变量配置，跨平台即装即用",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aijunjiang/dsh-doubao-search.git"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "doubao",
    "search",
    "volcengine",
    "web-search"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
